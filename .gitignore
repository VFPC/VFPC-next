############################
# Secrets & runtime state
############################
.env
.env.*
!.env.template
secrets/*
dockercompose/config/acme.json
**/acme.json

############################
# Backups
############################
backup/
vfpc_*/
# Re-include the test harness and CLI checker projects (vfpc_*/ catches these
# directories on Windows due to case-insensitive path matching).
!VFPC_Tests/
!VFPC_Tests/**
!VFPC_Check/
!VFPC_Check/**
*.tar.gz
*.tgz
*.zip

############################
# Docker runtime artifacts
############################
**/data/
**/volumes/
**/.docker/
**/docker-data/

############################
# Logs
############################
*.log
logs/
log/

############################
