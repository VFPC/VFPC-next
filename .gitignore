############################

# JetBrains
.idea/
*.iml
*.iws
*.ipr

# Visual Studio
.vs/
.vscode/
*.user
*.suo
*.db
*.opendb
*.VC.db
*.VC.VC.opendb

############################
# OS / editor cruft
############################
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

############################
